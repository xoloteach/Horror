config_version=5

[application]

config/name="HORROR"
config/description="God of War-inspired 3D hack-and-slash: Leviathan axe throw, embed, and Bezier recall."
run/main_scene="res://main.tscn"

[autoload]

AudioManager="*res://scripts/audio_manager.gd"
FX="*res://scripts/fx.gd"
